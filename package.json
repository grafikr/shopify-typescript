{
  "name": "@grafikr/shopify-typescript",
  "version": "2.7.0",
  "license": "MIT",
  "scripts": {
    "format": "biome format . --write",
    "check": "biome check . --write",
    "generate": "node scripts/generate-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grafikr/shopify-typescript.git"
  },
  "files": [
    "src",
    "global"
  ],
  "dependencies": {
    "type-fest": "^5.10.0"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./js": {
      "types": "./src/js/index.d.ts"
    },
    "./json": {
      "types": "./src/json/index.d.ts"
    },
    "./liquid": {
      "types": "./src/liquid/index.d.ts"
    },
    "./endpoints": {
      "types": "./src/endpoints/index.d.ts"
    },
    "./global/Shopify": {
      "types": "./global/Shopify.d.ts"
    },
    "./global/CustomEvents": {
      "types": "./global/CustomEvents.d.ts"
    },
    "./package.json": "./package.json"
  }
}
